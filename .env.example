# Credenciais do MFIT Personal (as mesmas de client.mfitpersonal.com.br)
MFIT_EMAIL=
MFIT_PASSWORD=

# Opcional: cola aqui o cookie `client_token` do navegador para pular o login.
# MFIT_TOKEN=

# Conta Google onde as notas do Keep serão criadas.
GOOGLE_EMAIL=

# Master token do Google (aas_et/...). Deixe VAZIO para usar o keyring do sistema,
# que é o lugar recomendado — rode `mfit2keep keep-login` e ele cuida disso.
# Preencha aqui só se preferir manter tudo no .env: o token equivale à senha da
# conta, não expira, e neste arquivo fica em texto puro.
GOOGLE_MASTER_TOKEN=
