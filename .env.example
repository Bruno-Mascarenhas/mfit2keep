# Credenciais do MFIT Personal (as mesmas de client.mfitpersonal.com.br)
MFIT_EMAIL=
MFIT_PASSWORD=

# Opcional: cola aqui o cookie `client_token` do navegador para pular o login.
# MFIT_TOKEN=

# Conta Google onde as notas do Keep serão criadas.
GOOGLE_EMAIL=

# Master token do Google (aas_et/...). Deixe VAZIO para usar o keyring do sistema,
# que é o padrão — `mfit2keep keep-login` cuida disso.
GOOGLE_MASTER_TOKEN=

# ---------------------------------------------------------------------------
# Segredos cifrados (recomendado)
#
# Rode `mfit2keep segredos proteger --escrever`: ele cifra a senha e o master
# token com o TPM2 desta máquina, apaga as linhas em texto puro e deixa aqui as
# versões abaixo. O blob só decifra nesta placa — backup vazado, disco roubado
# ou SSD devolvido em RMA não servem para nada.
#
# MFIT_PASSWORD_ENC=
# GOOGLE_MASTER_TOKEN_ENC=
